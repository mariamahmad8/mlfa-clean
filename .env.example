# Copy these names into Railway Variables. Never commit real values here.

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-unique-random-secret

# Canonical public URL used in emailed sign-in links.
APP_BASE_URL=https://your-domain.example

# Comma-separated hostnames only. Include a custom domain if one is used.
TRUSTED_HOSTS=your-domain.example

# Use "hybrid" during migration, then "microsoft" to disable magic links.
AUTH_MODE=microsoft
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Exact value to add under Entra App Registration > Authentication > Web.
ENTRA_REDIRECT_URI=https://your-domain.example/auth/microsoft/callback
# Store as a sealed Railway variable. A certificate credential is preferred long-term.
ENTRA_CLIENT_SECRET=replace-with-entra-secret-value
ENTRA_MAX_AUTH_AGE_SECONDS=3600

# Leave unset when the frontend and backend share one domain.
# ALLOWED_ORIGINS=https://separate-frontend.example

DATABASE_URL=postgresql://user:password@host:5432/database
OPENAI_API_KEY=replace-me

# Start at legacy. Follow v2/DATA_SECURITY.md before changing modes.
QUEUE_SECURITY_MODE=legacy
QUEUE_ENCRYPTION_CURRENT_VERSION=1
# Generate with:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
QUEUE_ENCRYPTION_KEY_V1=replace-with-fernet-key
